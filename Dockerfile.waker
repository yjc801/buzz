# syntax=docker/dockerfile:1.7
#
# buzz-waker — headless wake daemon, deployed as a normal always-on Fly app
# (see fly.waker.toml), not a Sprite. Sprites hibernate on idle by design
# (crates/buzz-backend-sprites/README.md); this daemon's entire job is
# staying connected and listening continuously across every watched agent,
# which is exactly the workload Sprites are built to suspend.
#
# Ships two binaries: buzz-waker itself, and buzz-backend-sprites. Provider
# *deployment* through buzz-backend-sprites is NOT functional yet — see the
# KNOWN GAP note below. buzz-provider-deploy (shared with desktop) discovers
# provider binaries by name on PATH — add more
# `-p buzz-backend-<id> --bin buzz-backend-<id>` lines below and to the
# runtime COPY as other providers are needed.
#
# Multi-arch is produced by building this file on native amd64 and arm64
# runners, matching Dockerfile.sprig's convention. Keep both bases pinned to
# manifest-list digests so either architecture resolves to immutable source
# bytes.
#
# The provider digest gap this file used to carry a KNOWN GAP note about is
# CLOSED, in both halves, and remote wake deploys for real. Kept as history
# because the shape of the fix is what constrains every future bump below:
#
#   1. buzz-provider-deploy refuses any staged provider whose bytes do not
#      match the SHA-256 a launch bundle pins (crates/buzz-waker/src/
#      effects.rs, provider_deploy_pinned — G1). That refusal is correct and
#      must not be relaxed.
#   2. The Linux artifact now exists and is stable:
#      .github/workflows/provider-sprites.yml publishes it, and this image
#      installs the published binary after verifying its checksum rather than
#      compiling its own (whose bytes drifted on every rebuild).
#   3. Desktop stopped hashing whatever sat on the issuing Mac. A bundle now
#      carries a digest per target (#44), read from
#      desktop/src-tauri/provider-digests.json, and the daemon matches the
#      entry for the platform it runs on.
#
# See docs/waker-provider-digest-gap.md for the full account.
#
# The published provider release this image installs. Pinned to a version tag
# on purpose: the rolling `buzz-backend-sprites-latest` asset is republished on
# every push to main, so its digest moves for reasons that have nothing to do
# with the provider. Pinning a tag is what makes the installed bytes — and
# therefore the digest a launch bundle pins — a fact rather than a moving
# target. Bump this deliberately, and expect issued bundles to need reissuing
# when you do.
ARG PROVIDER_SPRITES_REPO=yjc801/buzz
ARG PROVIDER_SPRITES_TAG=buzz-backend-sprites-v0.1.1

# Fetched, not compiled. Building it here made its bytes a function of the
# source revision and toolchain at image build time, so the digest drifted on
# every rebuild and nothing could pin it. See docs/waker-provider-digest-gap.md.
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS provider
ARG PROVIDER_SPRITES_REPO
ARG PROVIDER_SPRITES_TAG
# BuildKit sets TARGETARCH from the platform being built for, which is what
# makes this correct on both native runners rather than baking in one arch.
ARG TARGETARCH
RUN apk add --no-cache ca-certificates curl
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) TRIPLE=x86_64-unknown-linux-musl ;; \
      arm64) TRIPLE=aarch64-unknown-linux-musl ;; \
      *) echo "no published provider build for TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    ASSET="buzz-backend-sprites-${TRIPLE}"; \
    BASE="https://github.com/${PROVIDER_SPRITES_REPO}/releases/download/${PROVIDER_SPRITES_TAG}"; \
    cd /tmp; \
    # Retried hard, because this is the one step that leaves the builder's
    # network and the release CDN throttles it. Measured from Fly's remote
    # builder: one build took 503 on all seven attempts across ~18s while the
    # next succeeded on its first, and the same fetch is instant from a laptop
    # — GitHub rate-limiting unauthenticated release downloads from a shared
    # cloud egress IP. So the budget has to cover minutes, not seconds; curl's
    # default backoff grows between attempts and --retry-max-time caps the
    # whole thing rather than each try.
    #
    # A partial body cannot reach the checksum: curl only writes -o on
    # success, so a truncated download fails here as a network error rather
    # than surfacing later as a confusing digest mismatch.
    fetch() { curl -fsSL --retry 10 --retry-all-errors --retry-max-time 300 \
                   --connect-timeout 20 --max-time 300 -o "$1" "$2"; }; \
    fetch "$ASSET" "${BASE}/${ASSET}"; \
    fetch "${ASSET}.sha256" "${BASE}/${ASSET}.sha256"; \
    # Verified under the asset's own name, because the published .sha256 names
    # it — renaming first would silently verify nothing.
    sha256sum -c "${ASSET}.sha256"; \
    install -D -m 0755 "$ASSET" /out/buzz-backend-sprites; \
    echo "installed ${ASSET} from ${PROVIDER_SPRITES_TAG}:"; \
    sha256sum /out/buzz-backend-sprites

FROM rust:1.95-alpine3.22@sha256:064dfc925d68d1a63f4fd2871bd7dc6e6ea56692989a487185855d62885d90aa AS builder

RUN apk add --no-cache \
      build-base \
      cmake \
      git \
      musl-dev \
      openssl-dev \
      openssl-libs-static \
      perl \
      pkgconf \
      protoc
WORKDIR /build
COPY . .
RUN cargo build --release --locked \
      -p buzz-waker --bin buzz-waker \
    && strip target/release/buzz-waker

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

RUN apk add --no-cache bash ca-certificates \
    && adduser -D -h /home/waker waker \
    && install -d -o waker -g waker /data/waker /run/waker

COPY --from=builder --chmod=0755 /build/target/release/buzz-waker /usr/local/bin/buzz-waker
COPY --from=provider --chmod=0755 /out/buzz-backend-sprites /usr/local/bin/buzz-backend-sprites
COPY --chmod=0755 scripts/waker-entrypoint.sh /usr/local/bin/waker-entrypoint

ENV HOME=/home/waker \
    PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    WAKER_STATE_DIR=/data/waker \
    RUST_LOG=buzz_waker=info

# fly.waker.toml mounts the durable volume here — WAKER_STATE_DIR holds each
# watched agent's cursor.json and FloorStore, and the anti-rollback guarantee
# those pin depends on this surviving restarts.
VOLUME ["/data/waker"]

WORKDIR /home/waker
USER waker
ENTRYPOINT ["/usr/local/bin/waker-entrypoint"]
